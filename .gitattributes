# Deterministic line endings across Windows development and Linux GitHub Actions.
# Do not rely on core.autocrlf.

* text=auto eol=lf

# Text formats normalized to LF in the working tree on every platform.
*.kt            text eol=lf
*.kts           text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.xml           text eol=lf
*.properties    text eol=lf
*.sh            text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
gradlew         text eol=lf

# Windows-only scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never convert.
*.jar   binary
*.png   binary
*.webp  binary
