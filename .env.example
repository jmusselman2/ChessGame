# Template only. Copy to .env and fill in locally; never commit real values.
#
# The local development database is the disposable PostgreSQL container
# defined in compose.yaml (see docs/DEVELOPMENT.md). Its credentials are
# non-secret local values.
#
# Keep both of these pointed at that local container. The beta reuses the same
# Supabase project as development (D035), and the server tests run
# Migrations.reset, which drops everything in the schema -- so a TEST_DATABASE_URL
# aimed at Supabase would destroy beta data, which the Free plan cannot restore.
# The beta DATABASE_URL belongs only in the Render environment, never here.

DATABASE_URL=postgresql://chessgame:chessgame@localhost:55432/chessgame_dev
TEST_DATABASE_URL=postgresql://chessgame:chessgame@localhost:55432/chessgame_test

# Supabase development project (see docs/DEVELOPMENT.md). The URLs are not
# secrets; the key is yours to fill in locally and must never be committed.
# Get it with: supabase projects api-keys --project-ref rkwymrtqayyyfahfgmbm
SUPABASE_URL=https://rkwymrtqayyyfahfgmbm.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=https://rkwymrtqayyyfahfgmbm.supabase.co/auth/v1/.well-known/jwks.json
