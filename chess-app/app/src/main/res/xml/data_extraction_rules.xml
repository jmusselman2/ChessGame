<?xml version="1.0" encoding="utf-8"?><!--
   Backup and transfer rules for Android 12 and later. Android 11 and lower read
   backup_rules.xml instead; keep the two in step.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Local games stay on this installation (D084): the local-game database,
         LOCAL_GAME_DATABASE_NAME, and SQLite's companion files are neither backed up
         to the cloud nor moved to a new device. -->
    <cloud-backup>
        <exclude domain="database" path="local_games.db" />
        <exclude domain="database" path="local_games.db-journal" />
        <exclude domain="database" path="local_games.db-wal" />
        <exclude domain="database" path="local_games.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="local_games.db" />
        <exclude domain="database" path="local_games.db-journal" />
        <exclude domain="database" path="local_games.db-wal" />
        <exclude domain="database" path="local_games.db-shm" />
    </device-transfer>
</data-extraction-rules>
