<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and lower. Android 12 and later read
   data_extraction_rules.xml instead; keep the two in step.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Local games stay on this installation (D084): the local-game database,
         LOCAL_GAME_DATABASE_NAME, and SQLite's companion files are never backed up. -->
    <exclude domain="database" path="local_games.db" />
    <exclude domain="database" path="local_games.db-journal" />
    <exclude domain="database" path="local_games.db-wal" />
    <exclude domain="database" path="local_games.db-shm" />
</full-backup-content>
