-- A local game's move history, one row per ply, oldest first (D084).
--
-- `move` is the move in coordinate notation (`e2e4`, `e7e8q`), and `position_before` the
-- whole position it was played from, as JSON (LocalStateDocument). Together they are the
-- core's MoveRecord, so a game is rebuilt from rows without replaying a move (D061).
--
-- The history is only ever appended to or truncated from the end, never rewritten.
CREATE TABLE local_moves (
    game_id INTEGER NOT NULL REFERENCES local_games (id) ON DELETE CASCADE,
    ply INTEGER NOT NULL CHECK (ply >= 1),
    move TEXT NOT NULL,
    position_before TEXT NOT NULL,
    PRIMARY KEY (game_id, ply)
);

append:
INSERT INTO local_moves (game_id, ply, move, position_before)
VALUES (:gameId, :ply, :move, :positionBefore);

forGame:
SELECT ply, move, position_before FROM local_moves WHERE game_id = :gameId ORDER BY ply;

count:
SELECT count(*) FROM local_moves WHERE game_id = :gameId;

-- The first ply after :keep: the move a takeback to :keep plies undoes first.
firstAfter:
SELECT position_before FROM local_moves WHERE game_id = :gameId AND ply = :keep + 1;

truncate:
DELETE FROM local_moves WHERE game_id = :gameId AND ply > :keep;

deleteForActiveOfKind:
DELETE FROM local_moves WHERE game_id IN (SELECT id FROM local_games WHERE status = 'ACTIVE' AND kind = :kind);
